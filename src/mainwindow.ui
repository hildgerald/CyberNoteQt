 <!-- MarkdownEdit = notre widget custom (voir markdownedit.h), promu depuis QTextEdit.
      Qt Designer affichera une zone QTextEdit classique pour cette place réservée. -->
 <customwidgets>
  <customwidget>
   <class>MarkdownEdit</class>
   <extends>QTextEdit</extends>
   <header>markdownedit.h</header>
  </customwidget>

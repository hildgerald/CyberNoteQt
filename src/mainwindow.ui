           </widget>
          </item>
          <item>
           <widget class="QTreeWidget" name="treeProject">
            <property name="headerHidden">
             <bool>true</bool>
            </property>
            <column>
             <property name="text"><string>1</string></property>
            </column>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>

       <widget class="QGroupBox" name="gbTarget">
        <property name="title">
         <string>Target</string>
        </property>
        <layout class="QVBoxLayout" name="verticalLayout_target">
         <item>
          <widget class="QTableWidget" name="tableTarget">
           <property name="columnCount">
            <number>2</number>
           </property>
           <column>
            <property name="text"><string>Name</string></property>
           </column>
           <column>
            <property name="text"><string>Value</string></property>
           </column>
          </widget>
         </item>
        </layout>
       </widget>
      </widget>

      <!-- ===================== Colonne centrale : Note (éditeur markdown) ===================== -->
      <widget class="QTabWidget" name="tabNote">
       <widget class="QWidget" name="tabNotePage">
        <attribute name="title">
         <string>Note</string>
        </attribute>
        <layout class="QVBoxLayout" name="verticalLayout_note">
         <property name="leftMargin"><number>0</number></property>
         <property name="topMargin"><number>0</number></property>
         <property name="rightMargin"><number>0</number></property>
         <property name="bottomMargin"><number>0</number></property>
         <item>
          <widget class="QToolBar" name="toolBarNotes">
           <property name="windowTitle"><string>TB_Notes</string></property>
           <addaction name="actionNoteCopy"/>
           <addaction name="actionNoteCut"/>
           <addaction name="actionNotePaste"/>
           <addaction name="separator"/>
           <addaction name="actionNoteExecute"/>
          </widget>
         </item>
         <item>
          <widget class="MarkdownEdit" name="mdEditor">
           <property name="minimumSize">
            <size>
             <width>200</width>
             <height>200</height>
            </size>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </widget>

      <!-- ===================== Colonne droite : Bibliothèques ===================== -->
      <widget class="QTabWidget" name="tabLibraries">
       <widget class="QWidget" name="tabLibrariesPage">

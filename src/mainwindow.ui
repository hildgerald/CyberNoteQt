    <item>
     <widget class="QSplitter" name="mainSplitter">
      <property name="orientation">
       <enum>Qt::Horizontal</enum>
      </property>

      <!-- ===================== Colonne gauche : Projet + Target ===================== -->
      <widget class="QSplitter" name="leftSplitter">
       <property name="orientation">
        <enum>Qt::Vertical</enum>
       </property>

       <widget class="QTabWidget" name="tabProject">
        <widget class="QWidget" name="tabProjectPage">
         <attribute name="title">
          <string>Project</string>
         </attribute>
         <layout class="QVBoxLayout" name="verticalLayout_project">
          <property name="leftMargin"><number>0</number></property>
          <property name="topMargin"><number>0</number></property>
          <property name="rightMargin"><number>0</number></property>
          <property name="bottomMargin"><number>0</number></property>
          <item>
           <widget class="QToolBar" name="toolBarFiles">
            <property name="windowTitle"><string>TB_Files</string></property>
            <addaction name="actionNewProjectTb"/>
            <addaction name="actionOpenProjectTb"/>
            <addaction name="separator"/>
            <addaction name="actionAddMachine"/>
            <addaction name="actionAddFolder"/>
            <addaction name="actionNewNote"/>
            <addaction name="separator"/>
            <addaction name="actionTreeCopy"/>
